# ==============================================================================
# POSTFIX HA MULTI-VIP RELAY CONFIGURATION (.env)
# Environment: Red Hat Enterprise Linux 9 (RHEL 9) + Keepalived + 1:1 NAT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL & DOMAIN IDENTITY
# ------------------------------------------------------------------------------
TZ=Asia/Bangkok
MAIL_DOMAIN=company.com
MYHOSTNAME=mail.company.com

# ------------------------------------------------------------------------------
# 2. KEEPALIVED VIPs (1 INBOUND + DYNAMIC OUTBOUND 1-TO-1 HARDWARE NAT VIPs)
# ------------------------------------------------------------------------------
# INBOUND_VIP: The VIP that internal application servers connect to on port 25.
# Note: Postfix will bind to "${INBOUND_VIP}, 127.0.0.1" (or set INBOUND_INET_INTERFACES=all
# so it listens on the Inbound VIP and localhost seamlessly across Keepalived failovers).
INBOUND_VIP=10.10.10.100
INBOUND_INET_INTERFACES=all
# SMTP Inbound Port: Set to 25 for public MX reception (requires root or sysctl ip_unprivileged_port_start=25).
# Or set to a custom port (e.g. 2525, 587, 10025) for unprivileged / rootless container setups.
SMTP_INBOUND_PORT=25

# DYNAMIC OUTBOUND VIPs (Option 1 - Recommended: Numbered Variables):
# You can scale the number of outbound VIPs up or down dynamically:
#   - To scale down (e.g. 2 VIPs): simply keep OUTBOUND_VIP_1 and OUTBOUND_VIP_2 and omit/comment out 3+
#   - To scale up (e.g. 8 VIPs): simply add OUTBOUND_VIP_6, OUTBOUND_VIP_7, OUTBOUND_VIP_8, etc.
#   - When 2 or more VIPs are configured, Postfix balances across them via randmap round-robin.
#   - When exactly 1 VIP is configured, Postfix routes directly through that single VIP.
#
# IMPORTANT FOR GMAIL/YAHOO/OUTLOOK: Each Public IP must have a Reverse DNS (PTR)
# record matching its OUTBOUND_VIP_X_HELO hostname, and a forward A record back to that Public IP.
OUTBOUND_VIP_1=10.10.10.101
OUTBOUND_VIP_1_HELO=mail1.company.com

OUTBOUND_VIP_2=10.10.10.102
OUTBOUND_VIP_2_HELO=mail2.company.com

OUTBOUND_VIP_3=10.10.10.103
OUTBOUND_VIP_3_HELO=mail3.company.com

OUTBOUND_VIP_4=10.10.10.104
OUTBOUND_VIP_4_HELO=mail4.company.com

OUTBOUND_VIP_5=10.10.10.105
OUTBOUND_VIP_5_HELO=mail5.company.com

# Alternative (Option 2 - Single list variable, overrides numbered variables if set):
# OUTBOUND_VIPS=10.10.10.101:mail1.company.com,10.10.10.102:mail2.company.com,10.10.10.103:mail3.company.com

# ------------------------------------------------------------------------------
# 3. STRICT ACCESS CONTROL (ALLOWED NETWORKS & ALLOWED SENDER EMAILS)
# ------------------------------------------------------------------------------
# Only internal application servers in ALLOWED_NETWORKS (CIDR list) are permitted to connect.
ALLOWED_NETWORKS=127.0.0.0/8, 10.10.10.0/24, 192.168.1.0/24

# Only these exact Envelope-From (MAIL FROM) addresses are allowed to send mail.
# Any other sender address (even from an allowed IP) will be rejected with 554 5.7.1.
# You can also add additional senders in ./config/allowed_senders
ALLOWED_SENDERS=otp@company.com, notification@company.com

# Optional: Pin specific sender addresses to specific Outbound VIPs.
# By default (when empty), all allowed senders balance across all active VIPs.
# Format: comma-separated "sender@domain.com:target" where target is:
#   - vip1 .. vipN (single VIP, e.g. vip1, vip2, vip6)
#   - randmap:{smtp_vip1,smtp_vip2} (subset of VIPs, e.g. dedicated VIP pool for OTP!)
# Example: SENDER_VIP_MAPPINGS=otp@company.com:randmap:{smtp_vip1,smtp_vip2},notification@company.com:randmap:{smtp_vip3,smtp_vip4,smtp_vip5}
SENDER_VIP_MAPPINGS=

# ------------------------------------------------------------------------------
# 4. DESTINATION DOMAIN TRANSPORT MAPS (transport_maps)
# ------------------------------------------------------------------------------
# Forward specific destination domains to specific MX or SMTP relay servers.
# Format: comma-separated "destination_domain=transport:nexthop" entries.
# Examples:
#   partner.com=smtp:[10.20.30.40]:25
#   internal.company.com=smtp:[mail.internal.local]:2525
#   special-ext.com=smtp_vip1:[mx.special-ext.com]:25
# You can also add multi-line mappings in ./config/transport
TRANSPORT_MAPS=

# ------------------------------------------------------------------------------
# 5. OPENDKIM SIGNING CONFIGURATION
# ------------------------------------------------------------------------------
ENABLE_DKIM=true
DKIM_SELECTOR=mail
DKIM_KEY_BITS=2048
# Canonicalization: relaxed/simple is recommended for compatibility with Outlook/Gmail
DKIM_CANONICALIZATION=relaxed/simple

# ------------------------------------------------------------------------------
# 6. PERSISTENT LOGGING, JSON CONSOLIDATION & DAILY ROTATION
# ------------------------------------------------------------------------------
# Inside container paths (symlinked to persistent volume /var/log/mailserver -> ./logs on host)
MAILLOG_PATH=/var/log/maillog
CONSOLIDATED_LOG_PATH=/var/log/postfix-consolidate.log

# Regex of email headers to log via Postfix header_checks (INFO) and capture in postfix-consolidate.log JSON
LOG_HEADERS_REGEX=^(Subject|From|To|Cc|Date|Message-ID|Reply-To|X-[A-Za-z0-9-]+):

# Strip internal application server Received: headers (RFC1918 private IPs) before sending externally
STRIP_INTERNAL_RECEIVED=true

# Flush timeout (seconds) for in-flight queue IDs in the JSON log consolidator
CONSOLIDATE_QUEUE_TIMEOUT_SEC=300

# Daily logrotate retention (days) and compression
LOG_RETENTION_DAYS=30
LOG_COMPRESS=true

# ------------------------------------------------------------------------------
# 7. SMTP TIMEOUTS, QUEUE LIFETIMES & OTP TUNING
# ------------------------------------------------------------------------------
# Outbound SMTP client timeouts
SMTP_CONNECT_TIMEOUT=20s
SMTP_HELO_TIMEOUT=30s
SMTP_MAIL_TIMEOUT=60s
SMTP_RCPT_TIMEOUT=60s
SMTP_DATA_DONE_TIMEOUT=120s
SMTP_QUIT_TIMEOUT=30s

# Inbound SMTP server timeout (for local application servers)
SMTPD_TIMEOUT=60s

# Queue retry & lifetime tuning (Optimized for OTP & transactional emails:
# 4h maximal queue lifetime prevents stale OTP emails from delivering days late)
MAXIMAL_QUEUE_LIFETIME=4h
BOUNCE_QUEUE_LIFETIME=4h
MINIMAL_BACKOFF_TIME=120s
MAXIMAL_BACKOFF_TIME=900s
QUEUE_RUN_DELAY=120s

# ------------------------------------------------------------------------------
# 8. CONCURRENCY, RATE LIMITS & TLS (GMAIL / YAHOO / OUTLOOK DELIVERABILITY)
# ------------------------------------------------------------------------------
DEFAULT_PROCESS_LIMIT=100
SMTP_DESTINATION_CONCURRENCY_LIMIT=20
SMTP_DESTINATION_RECIPIENT_LIMIT=50
SMTP_DESTINATION_RATE_DELAY=0s
INITIAL_DESTINATION_CONCURRENCY=5
MESSAGE_SIZE_LIMIT=10485760

# Outbound TLS settings ("may" = opportunistic STARTTLS, required by Gmail/Yahoo/Outlook)
SMTP_TLS_SECURITY_LEVEL=may
SMTP_TLS_LOGLEVEL=1
SMTPD_TLS_SECURITY_LEVEL=none
